# انسخ هذا الملف إلى .env وعدّل القيم قبل التشغيل
PORT=3000

# غيّر هذا السر إلى نص طويل وعشوائي وسري جدًا (لا تشاركه أبدًا)
JWT_SECRET=change_this_to_a_very_long_random_secret_string

# بيانات دخول أول حساب أدمن (تُستخدم مرة واحدة عند تشغيل: npm run seed:admin)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=ChangeThisPassword123!

# اسم المتجر ورابطه (تُستخدم في ملفات الكتالوج لفيسبوك/تيك توك)
STORE_NAME=متجري
STORE_URL=https://example.com

# النطاقات المسموح لها بالوصول للـ API (افصل بينها بفاصلة)
ALLOWED_ORIGINS=http://localhost:3000

# إعدادات SMTP لإرسال رموز التحقق عبر الإيميل (Gmail مثال)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-gmail-app-password
